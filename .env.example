# === Public (aman untuk diekspos ke browser) ===
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STATIC_QRIS=
# Nomor WhatsApp panitia untuk pemesanan E-Voucher (format internasional tanpa +,
# mis. 6281234567890). Kosongkan bila belum ada — tombol "Pesan Via WhatsApp" otomatis disembunyikan.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# === Server-only (JANGAN pernah pakai prefix NEXT_PUBLIC_) ===
# Service Role key dari dashboard Supabase (Settings > API).
# Dipakai hanya di API route server-side. Dengan ini, akses anon bisa dikunci penuh di RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk menandatangani cookie sesi login. Wajib diisi di production,
# gunakan nilai acak yang panjang, mis. `openssl rand -hex 32`.
AUTH_SESSION_SECRET=
